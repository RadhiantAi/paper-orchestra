# Copy to .env. Set only the providers you choose. Never commit credentials.
# Replace YOUR_MODEL_ID with an available model ID from your provider.
PAPER_WRITER_MODEL=openai:YOUR_MODEL_ID
# Blank values below use PAPER_WRITER_MODEL.
PAPER_REVIEW_MODEL=
PAPER_SEARCH_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Vertex AI is an alternative to GEMINI_API_KEY and uses application-default credentials.
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# For compatible:YOUR_MODEL_ID only. Do not put credentials in the URL.
LLM_BASE_URL=
LLM_API_KEY=

SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
OPENALEX_API_KEY=
LITERATURE_CONTACT_EMAIL=
LITERATURE_SOURCES=pubmed,openalex,semantic_scholar,crossref
LITERATURE_RESULTS_PER_SOURCE=20
LITERATURE_MAX_REQUESTS=80
LITERATURE_MAX_SECONDS=180
LITERATURE_REQUEST_TIMEOUT=20
LITERATURE_REQUIRE_ALL_SOURCES=false
LITERATURE_COLLECTION_PATH=
PAPER_MAX_OUTPUT_TOKENS=16384
PAPER_API_TIMEOUT=300
PAPER_MODEL_POLICY=model-policy.json
# Explicitly set a positive estimate limit before using a paid endpoint.
PAPER_MAX_COST_USD=0
PAPER_MAX_MODEL_CALLS=80
# live performs small capability probes on an actual run; declared uses only the policy.
PAPER_PROBE_MODE=live
PAPER_TEX_IMAGE=paper-orchestra-tex:local
